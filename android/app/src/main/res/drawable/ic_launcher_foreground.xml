<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="60"
    android:viewportHeight="60">

    <!-- Green oval — top grain -->
    <group
        android:translateX="30"
        android:translateY="10">
        <path
            android:pathData="M0,0m-8,0a8,12,0,1,0,16,0a8,12,0,1,0,-16,0"
            android:fillColor="#5A9F3C"/>
    </group>

    <!-- Gold oval — bottom-left grain, rotated 60° -->
    <group
        android:translateX="11"
        android:translateY="43"
        android:rotation="60"
        android:pivotX="0"
        android:pivotY="0">
        <path
            android:pathData="M0,0m-8,0a8,12,0,1,0,16,0a8,12,0,1,0,-16,0"
            android:fillColor="#D4A13C"/>
    </group>

    <!-- Terra oval — bottom-right grain, rotated -60° -->
    <group
        android:translateX="49"
        android:translateY="43"
        android:rotation="-60"
        android:pivotX="0"
        android:pivotY="0">
        <path
            android:pathData="M0,0m-8,0a8,12,0,1,0,16,0a8,12,0,1,0,-16,0"
            android:fillColor="#C97C3E"/>
    </group>

    <!-- Center ring -->
    <group
        android:translateX="30"
        android:translateY="30">
        <path
            android:pathData="M0,0m-4,0a4,4,0,1,0,8,0a4,4,0,1,0,-8,0"
            android:fillColor="#00000000"
            android:strokeColor="#1A1F17"
            android:strokeWidth="1.6"/>
